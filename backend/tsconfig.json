{
  "ts-node": {
    "files": true,
    "transpileOnly": true
  },
  "compilerOptions": {
    "plugins": [{"transform": "typescript-transform-paths"}],
    "paths": {
      "@authwithback/frontend/*": ["../frontend/*"],
      "@authwithback/shared/*": ["../shared/*"]
    },
    "outDir": "./dist",
    "rootDir": "..",
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "strict": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "inlineSources": true,
    "isolatedModules": false,
    "lib": ["ES2021"],
    "types": ["node"],
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2021"
  },
  "include": ["src/**/*.ts"]
}
